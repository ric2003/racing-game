[Unit]
Description=Neon Apex multiplayer server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/codex-workspace/projects/racing-game
Environment=NODE_ENV=production
EnvironmentFile=%h/.config/neon-apex/server.env
ExecStart=/usr/local/bin/node dist-server/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
